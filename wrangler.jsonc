{
  // SMF Condo Activation. Separate from the Barker's Worker (smf-pet-shop-api); shares nothing with it.
  "name": "smf-condo-activation",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-09-30",
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
